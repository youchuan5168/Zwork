# 复制为 backend/.env，切勿提交真实密钥
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=qiuzhao
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=30
REGISTRATION_OPEN=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 开发保留旧行为；生产必须关闭并先运行迁移
AUTO_CREATE_DATABASE=true
AUTO_CREATE_TABLES=true
# DATABASE_URL=sqlite:///./dev.db
# JWT_SECRET 的 change-me 占位值无法启动，请生成至少 32 位随机密钥。
# 生产：APP_ENV=production，关闭自动建库建表，明确 HTTPS CORS 与域名。

# 阶段 1 Agent：密钥仅配置于后端，模型名称需与你的 API 账号权限匹配
AGENT_ENABLED=false
AGENT_PROVIDER=openai_responses
# DeepSeek 使用 AGENT_PROVIDER=deepseek_chat 和 https://api.deepseek.com/chat/completions
# OPENAI_API_KEY 为当前兼容的通用服务端密钥字段，选择 DeepSeek 时填 DeepSeek 密钥
# 完整端点；当前 Provider 使用 Responses 协议，不是 Chat Completions
AGENT_API_URL=https://api.openai.com/v1/responses
OPENAI_API_KEY=
AGENT_MODEL=
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_TOTAL_TOKENS=30000
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_TIMEOUT_SECONDS=60

